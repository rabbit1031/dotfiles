{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "google/gemini-4-argon[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "Fable (Custom - Google: Gemini 4 Argon)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "openai/gpt-6.1-sol[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Opus (Custom - OpenAI: GPT-6.1 Sol)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "openai/gpt-6.1-terra[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Sonnet (Custom - OpenAI: GPT-6.1 Terra)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "google/gemini-3.8-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Haiku (Custom - Google: Gemini 3.8 Flash)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "openai/gpt-6-luna[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "GPT-6 Luna"
  },
  "apiKeyHelper": "op read 'op://Private/OpenRouter/coding-agent-api-key'",
  "model": "openai/gpt-6.1-terra[1m]",
  "statusLine": {
    "type": "command",
    "command": "pnpm dlx ccstatusline@latest --config \"$HOME/.claude-openrouter/ccstatusline-settings.json\"",
    "padding": 0,
    "refreshInterval": 10
  }
}
