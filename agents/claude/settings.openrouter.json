{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "anthropic/claude-fable-5.1[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "Fable 5.1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "anthropic/claude-opus-5.5[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Opus 5.5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "anthropic/claude-sonnet-5.5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Sonnet 5.5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "openai/gpt-6-luna[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Haiku (Custom - OpenAI: GPT-6 Luna)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "google/gemini-3.8-flash[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Gemini 3.8 Flash"
  },
  "apiKeyHelper": "op read 'op://Private/OpenRouter/claude-code-api-key'",
  "model": "google/gemini-3.8-flash[1m]",
  "statusLine": {
    "type": "command",
    "command": "pnpm dlx ccstatusline@latest --config \"$HOME/.claude-openrouter/ccstatusline-settings.json\"",
    "padding": 0,
    "refreshInterval": 10
  }
}
