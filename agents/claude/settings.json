{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(./gradlew tasks*)",
      "Bash(./gradlew dependencies*)",
      "Bash(./gradlew projects*)",
      "Bash(./gradlew properties*)",
      "Bash(./gradlew --version*)",
      "Bash(./gradlew test*)",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-get-comments",
      "mcp__claude_ai_Notion__notion-get-teams",
      "mcp__claude_ai_Notion__notion-get-users",
      "mcp__claude_ai_Notion__notion-search",
      "Bash(gh repo list*)",
      "Bash(gh repo gitignore*)",
      "Bash(gh repo license*)",
      "Bash(gh release verify*)",
      "Bash(gh label list*)",
      "Bash(gh search*)",
      "Bash(gh ruleset list*)",
      "Bash(gh ruleset view*)",
      "Bash(gh ruleset check*)",
      "Bash(gh cache list*)",
      "Bash(gh org list*)",
      "Bash(gh gist list*)",
      "Bash(gh gist view*)",
      "Bash(gh project list*)",
      "Bash(gh project view*)",
      "Bash(gh project item-list*)",
      "Bash(gh project field-list*)",
      "mcp__Homebrew__list",
      "mcp__Homebrew__info",
      "mcp__Homebrew__search",
      "mcp__Homebrew__config",
      "mcp__Homebrew__doctor",
      "mcp__Homebrew__commands",
      "mcp__Homebrew__help"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/credentials)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean -fd*)",
      "Bash(rm *)",
      "Bash(cat ~/.ssh/*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git -C * add*)",
      "Bash(git -C * push*)",
      "Bash(git -C * commit --amend*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "myusage@myusage-skill": true,
    "commit-commands@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true
  },
  "extraKnownMarketplaces": {
    "myusage-skill": {
      "source": {
        "source": "github",
        "repo": "bdangit/myusage-skill"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "high",
  "tui": "fullscreen",
  "verbose": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "model": "opusplan"
}
