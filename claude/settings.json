{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(./gradlew tasks*)",
      "Bash(./gradlew dependencies*)",
      "Bash(./gradlew projects*)",
      "Bash(./gradlew properties*)",
      "Bash(./gradlew --version*)",
      "Bash(./gradlew test*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git push*)",
      "Bash(git commit --amend*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm *)",
      "Bash(cat ~/.ssh/*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)"
    ]
  }
}
